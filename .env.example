# PAIOS Knowledge Layer Integration
# Point to a PAIOS Knowledge Layer export endpoint for live article data.
# If not set, the app falls back to public/latest.json fixture.
PAIOS_LATEST_JSON_URL=https://example.com/api/latest

# PAIOS Public API for curated content (daily briefs, weekly highlights, etc.)
# If not set, the app uses local JSON fixtures in the data/ folder.
PAIOS_API_URL=https://example.com/api
